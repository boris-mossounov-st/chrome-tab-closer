{
  "manifest_version": 3,
  "name": "Tab Closer",
  "version": "1.1.0",
  "description": "Automatically closes tabs whose URL matches your rules after a period of inactivity (Zoom launchers, SSO/login pages, Google Docs...).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Tab Closer",
    "default_popup": "options.html?popup=1",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
